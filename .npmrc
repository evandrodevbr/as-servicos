ignore-workspace-root-check=true
# Turbopack (Next 16) não atravessa as junctions do pnpm para resolver deps
# transitivas (jose, zod, nanostores, @better-auth/core...) dentro do virtual
# store isolado no Windows — resolução ascendente falha com "Module not found".
# Hoisting público traz as deps transitivas para node_modules/ raiz, onde o
# walk do bundler encontra. Remover se o Turbopack resolver o bug.
public-hoist-pattern[]=*
